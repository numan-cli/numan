# numan local development environment (names only — no values are committed).
#
# In development, values come from the Infisical project's `dev` environment:
#   scripts/dev.sh list
# See ../INFISICAL.md (workspace root) for setup, the CI-only variables, and the
# acceptance-test knobs.

# Override the numan root directory (default: platform data dir).
NUMAN_ROOT=

# Set to 1 to accept an unsigned registry index (local experiments only).
NUMAN_ALLOW_UNSIGNED=

# Set to 1 to opt into mutating already-active plugins during update.
NUMAN_ENABLE_ACTIVE_PLUGIN_MUTATION=

# nupm home used by `numan nupm status`, `inspect`, `import`, and `diff`.
NUPM_HOME=

# GitHub API token for `numan setup loader --install` and scripts/watch_nu_releases.py.
GITHUB_TOKEN=
GH_TOKEN=

# Base64 Ed25519 seed (32 bytes) used by scripts/sign-sha256sums.py.
NUMAN_RELEASE_SIGNING_KEY=
